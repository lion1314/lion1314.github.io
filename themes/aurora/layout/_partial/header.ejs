<%
var active = page.nav || 'home';
if (!page.nav) {
  if (page.category) active = 'categories';
  else if (page.tag) active = 'tags';
  else if (page.archive) active = 'archives';
}
var menu = theme.menu || [
  { name: '文章', url: '/', key: 'home' },
  { name: '归档', url: '/archives/', key: 'archives' },
  { name: '分类', url: '/categories/', key: 'categories' },
  { name: '标签', url: '/tags/', key: 'tags' },
  { name: '关于', url: '/about/', key: 'about' }
];
%>
<header class="site-header">
  <div class="wrap header-inner">
    <a class="brand" href="<%- url_for('/') %>">
      <span class="brand-mark" aria-hidden="true"></span>
      <span class="brand-text"><%= config.title %></span>
    </a>

    <nav class="main-nav" id="mainNav" aria-label="主导航">
      <% menu.forEach(function (m) { %>
      <a href="<%- url_for(m.url) %>" class="<%= m.key === active ? 'on' : '' %>"><%= m.name %></a>
      <% }); %>
    </nav>

    <div class="header-actions">
      <button class="icon-btn" id="themeToggle" type="button" aria-label="切换深浅色" title="切换深浅色">
        <svg class="i-moon" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z"/></svg>
        <svg class="i-sun" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="4"/><path d="M12 2v2m0 16v2M4.9 4.9l1.4 1.4m11.4 11.4 1.4 1.4M2 12h2m16 0h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"/></svg>
      </button>
      <button class="icon-btn menu-btn" id="menuToggle" type="button" aria-label="展开菜单" aria-expanded="false">
        <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" aria-hidden="true"><path d="M4 7h16M4 12h16M4 17h16"/></svg>
      </button>
    </div>
  </div>
</header>
